# Aplicação
PORT=3000

# Banco de dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gerenciador_documentos

# URL de conexão usada pela aplicação (Prisma)
# Em execução local (fora do Docker) use host=localhost
# Dentro do docker-compose o host é o nome do serviço: "db"
# Em produção (ex.: Neon), use a string POOLED com ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gerenciador_documentos?schema=public"

# Conexão DIRETA usada pelas migrations (prisma migrate deploy).
# Local: igual à DATABASE_URL. Em produção (Neon): string DIRECT com ?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gerenciador_documentos?schema=public"
