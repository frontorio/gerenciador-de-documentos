# Aplicação
PORT=3000

# Banco de dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gerenciador_documentos

# URL de conexão usada pelo Prisma
# Em execução local (fora do Docker) use host=localhost
# Dentro do docker-compose o host é o nome do serviço: "db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gerenciador_documentos?schema=public"
